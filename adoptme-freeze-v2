---------------------------------------------------------------- LOGIC
local running, runId = false, 0

if getgenv then
    getgenv().AutoPlayStop = function() running = false runId += 1 end
end

local function setRow(i, state)
    rows[i].Text = ({ wait = "o", work = "▶", done = "✓", skip = "-" })[state] .. " " .. STEPS[i].name
end

local function cycle(id)
    for i = 1, #STEPS do setRow(i, "wait") end
    for i, s in ipairs(STEPS) do
        if not running or id ~= runId then return end

        local skipObj = s.skipIf and resolve(s.skipIf)
        if s.walk then
            setRow(i, "work")
            status.Text = "Status : " .. s.name
            task.wait(TELEPORT_WAIT)
            if not (running and id == runId) then return end
            walkTo(s.walk, function() return running and id == runId end)
            if not (running and id == runId) then return end
            faceForward()
            setRow(i, "done")
        elseif s.tapChar then
            setRow(i, "work")
            status.Text = "Status : " .. s.name
            task.wait(SETTLE)
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local cam = workspace.CurrentCamera
            if root and cam then
                local v, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen then
                    local ty = v.Y + (s.dy or 0)
                    setLast(string.format("%s: %d,%d", s.name, v.X, ty))
                    showDot(v.X, ty)
                    humanTap(v.X, ty)
                    setRow(i, "done")
                end
            end
            task.wait(AFTER_CLICK)
            if not (running and id == runId) then return end
        elseif skipObj and reallyVisible(skipObj) then
            setRow(i, "skip")
        else
            setRow(i, "work")
            status.Text = "Status : " .. s.name
            local t, target = 0, nil
            while t < STEP_TIMEOUT and running and id == runId do
                target = getTarget(s)
                if target then break end
                task.wait(POLL); t += POLL
            end
            if not (running and id == runId) then return end
            if target then
                task.wait(SETTLE)
                target = getTarget(s) or target
                press(target, s.method, s.name, s.dy)
                setRow(i, "done")
                task.wait(AFTER_CLICK)
            else
                setRow(i, "wait")
            end
        end
    end
end

local function playVisible()
    return getTarget(STEPS[1]) ~= nil
end

local function startRun()
    if running then return end
    running = true
    runId += 1
    local id = runId
    local function alive() return running and id == runId end
    task.spawn(function()
        while alive() do
            status.Text = "Status : WAIT LOBBY"
            while alive() and not playVisible() do task.wait(0.5) end
            if not alive() then break end

            status.Text = "Status : RUNNING"
            local ok, err = pcall(cycle, id)
            if not ok then
                print("Error:", err)
                setLast("ERR " .. tostring(err))
            end
            if not alive() then break end

            if playVisible() then
                status.Text = "Status : RETRY"
                task.wait(LOOP_DELAY)
            else
                status.Text = "Status : DONE"
                while alive() and playVisible() == false do task.wait(0.5) end
            end
        end
    end)
end

