---------------------------------------------------------------- HELPERS
local function resolve(path)
    local cur = pg
    for part in string.gmatch(path, "[^%.]+") do
        cur = cur and cur:FindFirstChild(part)
        if not cur then return nil end
    end
    return cur
end

local function reallyVisible(obj)
    if not obj or not obj.Parent then return false end
    local cur = obj
    while cur and cur ~= pg do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return obj.AbsoluteSize.X > 0
end

local function norm(t)
    t = tostring(t or "")
    t = t:gsub("<[^>]+>", "")
    t = t:match("^%s*(.-)%s*$") or ""
    return string.lower(t)
end

local function findByText(word)
    for _, sg in ipairs(pg:GetChildren()) do
        if sg:IsA("ScreenGui") and sg.Enabled then
            for _, d in ipairs(sg:GetDescendants()) do
                if d:IsA("GuiButton") and reallyVisible(d) then
                    local match = d:IsA("TextButton") and norm(d.Text) == word
                    if not match then
                        for _, t in ipairs(d:GetDescendants()) do
                            if t:IsA("TextLabel") and norm(t.Text) == word then
                                match = true
                                break
                            end
                        end
                    end
                    if match then return d end
                end
            end
        end
    end
    return nil
end

local function findChoice(word)
    local holder = resolve("InteractionsApp.ChoiceSelects.Frame")
    if not holder then return nil end
    for pass = 1, 2 do
        for _, item in ipairs(holder:GetChildren()) do
            local fr = item:FindFirstChild("Frame")
            local tc = fr and fr:FindFirstChild("TextContainer")
            local tl = tc and tc:FindFirstChild("TextLabel")
            local btn = fr and fr:FindFirstChild("Front")
            if tl and btn and reallyVisible(btn) then
                local txt = norm(tl.Text)
                if (pass == 1 and txt == word) or (pass == 2 and string.find(txt, word, 1, true)) then
                    return btn
                end
            end
        end
    end
    return nil
end

local function getTarget(step)
    if step.choice then return findChoice(step.choice) end
    if step.findText then return findByText(step.findText) end
    if step.container then
        local c = resolve(step.container)
        if c then
            for _, b in ipairs(c:GetChildren()) do
                if b:IsA("GuiButton") and reallyVisible(b) then
                    local tl = b:FindFirstChild("TextLabel", true)
                    if tl and string.find(string.lower(tl.Text), step.pickText, 1, true) then
                        return b
                    end
                end
            end
        end
        return nil
    end
    local obj = resolve(step.path)
    if obj and reallyVisible(obj) then return obj end
end

local function inset(btn)
    local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
    if sg and sg.IgnoreGuiInset then return 0 end
    return GuiService:GetGuiInset().Y
end

-- only ONE tap at a time, so two features never click over each other
local tapBusy = false
local function humanTap(x, y)
    local t0 = tick()
    while tapBusy and tick() - t0 < 3 do task.wait(0.05) end
    tapBusy = true
    pcall(function()
        x += math.random(-2, 2)
        y += math.random(-2, 2)
        if USE_TOUCH then
            VIM:SendTouchEvent(1, 0, x, y)
            task.wait(0.08 + math.random() * 0.07)
            VIM:SendTouchEvent(1, 2, x, y)
        else
            VIM:SendMouseMoveEvent(x, y, game)
            task.wait(0.15 + math.random() * 0.1)
            VIM:SendMouseMoveEvent(x + 1, y + 1, game)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.08 + math.random() * 0.07)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
    end)
    tapBusy = false
end

local function fire(btn)
    if not getconnections or not btn:IsA("GuiButton") then return false end
    local n = 0
    for _, sig in ipairs({ btn.MouseButton1Down, btn.MouseButton1Up, btn.MouseButton1Click, btn.Activated }) do
        for _, c in ipairs(getconnections(sig)) do
            n += 1
            task.spawn(function() pcall(function() c:Fire() end) end)
        end
    end
    return n > 0
end

local function tapAt(btn, name, dy)
    local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
    local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2 + inset(btn) + OFFSET_Y + (dy or 0)
    setLast(string.format("%s: %d,%d  inset:%d", name, cx, cy, inset(btn)))
    showDot(cx, cy)
    humanTap(cx, cy)
end

local function press(btn, method, name, dy)
    if method == "fire" then
        if not fire(btn) then tapAt(btn, name, dy) end
    else
        tapAt(btn, name, dy)
    end
end

---------------------------------------------------------------- WALK
local function flatDist(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local jumpDots = 0
local function jumpNow(hum)
    local btn = resolve("TouchGui.TouchControlFrame.JumpButton")
    if btn and reallyVisible(btn) then
        local sg = btn:FindFirstAncestorWhichIsA("ScreenGui")
        local cx = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
        local cy = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
        if not (sg and sg.IgnoreGuiInset) then
            cy += inset(btn) + OFFSET_Y
        end
        cy += JUMP_DY
        if jumpDots < 3 then
            jumpDots += 1
            showDot(cx, cy)
        end
        task.spawn(humanTap, cx, cy)
    end
    if hum then hum.Jump = true end
end

local function walkTo(target, alive)
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 10)
    local root = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not root then return end

    local path, ok
    if USE_PATHFINDING then
        path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        ok = pcall(function() path:ComputeAsync(root.Position, target) end)
    end
    if USE_PATHFINDING and ok and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if not alive() then return end
            if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            hum:MoveTo(wp.Position)
            local reached = false
            local conn = hum.MoveToFinished:Connect(function() reached = true end)
            local t0 = tick()
            while not reached and tick() - t0 < 4 and alive() do task.wait(0.1) end
            conn:Disconnect()
        end
    end

    local t0, lastPos, lastCheck, lastJump = tick(), root.Position, tick(), 0
    while alive() and flatDist(root.Position, target) > 5 and tick() - t0 < 240 do
        hum:MoveTo(target)
        if JUMP_WHILE_WALKING and tick() - lastJump > JUMP_EVERY then
            jumpNow(hum)
            lastJump = tick()
        end
        task.wait(0.25)
        if tick() - lastCheck > 2 then
            if (root.Position - lastPos).Magnitude < 1 then jumpNow(hum) end
            lastPos, lastCheck = root.Position, tick()
        end
    end
end

local function faceForward()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end
    if hum then hum:MoveTo(root.Position) end
    task.wait(0.25)
    local dir = Vector3.new(FACE_DIR.X, 0, FACE_DIR.Z)
    if dir.Magnitude < 0.01 then return end
    root.CFrame = CFrame.lookAt(root.Position, root.Position + dir.Unit)
end

