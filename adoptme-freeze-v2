-- the Done button (new pet screen) was tapped too LOW. Negative moves the tap UP.
-- If the dot is still below the button use a bigger negative number (-35). If it is too high, use -15.
local DONE_DY = -25

local FIRST_METHOD  = "click"
local SECOND_METHOD = "click"

local function stillThere(b)
    return b and b.Parent and reallyVisible(b)
end

local function btnText(b)
    local tl = b:FindFirstChild("TextLabel", true)
    return tl and norm(tl.Text) or nil
end

-- presses until the button is gone. Each retry moves the tap a little (lower, higher, back)
local SWEEP = { 0, 12, -12, 0 }
local function pressUntilGone(b, name, tries, dy)
    for i = 1, tries do
        if not stillThere(b) then return true end
        local m = (i % 2 == 1) and FIRST_METHOD or SECOND_METHOD
        local d = (dy or 0) + (SWEEP[i] or 0)
        setLast(name .. " #" .. i .. " " .. m)
        pcall(press, b, m, name, d)
        task.wait(RETRY_WAIT)
    end
    return not stillThere(b)
end

local cfOpen, cfSince = false, 0
local negOpen, negSince, negLastPress, negWasBlocked, negTries = false, 0, 0, false, 0

local function canTry(b)
    local t = handled[b]
    return (not t) or (RESET_AFTER > 0 and tick() - t > RESET_AFTER)
end

local function tradeTick()
    -- 1) trade request / warning pop-up (unbalanced ...)
    local c = resolve(TRADE_DIALOG)
    if c then
        for _, b in ipairs(c:GetChildren()) do
            if b:IsA("GuiButton") and reallyVisible(b) and canTry(b) then
                local tx = btnText(b)
                local plain = tx and tx:gsub("[%p%s]", "")
                if tx and string.find(tx, "accept", 1, true) then
                    handled[b] = tick()
                    pressUntilGone(b, "Trade request", 4, TRADE_DY)
                elseif plain and OK_WORDS[plain] then
                    handled[b] = tick()
                    pressUntilGone(b, "Warning OK", 4, TRADE_DY)
                end
            end
        end
    end

    -- 2) trade window, offer Accept: press NEG_DELAY seconds after it appears.
    --    If the press did not work (button still says Accept), it tries again every 1.5s.
    local n = resolve(TRADE_NEGOTIATE)
    if n and reallyVisible(n) then
        local now = tick()
        local tx = btnText(n) or "accept"
        local blocked = tx:find("accepted", 1, true) or tx:find("unaccept", 1, true) or tx:find("cancel", 1, true)

        if not negOpen then
            negOpen, negSince, negLastPress, negWasBlocked, negTries = true, now, 0, false, 0
        end

        if blocked then
            negWasBlocked = true          -- already accepted, wait
        else
            if negWasBlocked then         -- the offer changed (pet added), count the delay again
                negWasBlocked = false
                negSince = now
                negTries = 0
            end
            local left = NEG_DELAY - (now - negSince)
            if left > 0 then
                setLast(string.format("Trade Accept in %.0fs", left))
            elseif now - negLastPress >= 1.5 then
                negLastPress = now
                negTries += 1
                local d = TRADE_DY + (SWEEP[(negTries - 1) % 4 + 1] or 0)
                setLast(string.format("Trade Accept try #%d", negTries))
                pcall(press, n, "click", "Trade Accept", d)
            end
        end
    else
        negOpen, negWasBlocked = false, false
    end

    -- 3) final confirm
    local cf = resolve(TRADE_CONFIRM)
    if cf and reallyVisible(cf) then
        if not cfOpen then cfOpen, cfSince = true, tick() end
        if tick() - cfSince >= CONFIRM_DELAY and canTry(cf) then
            handled[cf] = tick()
            pressUntilGone(cf, "Trade Confirm", 4, TRADE_DY)
        end
    else
        cfOpen = false
    end
end

local function doneTick()
    local list = {}
    for _, p in ipairs(DONE_PATHS) do
        local b = resolve(p)
        if b and reallyVisible(b) then table.insert(list, b) end
    end
    for _, w in ipairs(DONE_WORDS) do
        for _, b in ipairs(findAllByText(w)) do table.insert(list, b) end
    end
    for _, b in ipairs(list) do
        if canTry(b) then
            handled[b] = tick()
            pressUntilGone(b, "Done", 4, DONE_DY)
        end
    end
end

local function cashTick()
    for _, p in ipairs(CASHOUT_PATHS) do
        local b = resolve(p)
        if b and reallyVisible(b) and canTry(b) then
            handled[b] = tick()
            task.wait(CASH_SETTLE)
            if stillThere(b) then
                pressUntilGone(b, "Cash Out", 4, 0)
            end
        end
    end
end

local function notifTick()
    for _, p in ipairs(NOTIF_PATHS) do
        local b = resolve(p)
        if b and reallyVisible(b) and canTry(b) then
            handled[b] = tick()
            task.wait(NOTIF_SETTLE)
            if stillThere(b) then
                setLast("Notification")
                pcall(press, b, "click", "Notification", NOTIF_DY)
            end
        end
    end
end

task.spawn(function()
    while gui.Parent do
        pcall(function()
            for b in pairs(handled) do
                if not reallyVisible(b) then handled[b] = nil end
            end
        end)
        if autoAccept then
            local ok, err = pcall(tradeTick)
            if not ok then setLast("ERR trade: " .. tostring(err)) end
            ok, err = pcall(doneTick)
            if not ok then setLast("ERR done: " .. tostring(err)) end
            ok, err = pcall(cashTick)
            if not ok then setLast("ERR cash: " .. tostring(err)) end
            ok, err = pcall(notifTick)
            if not ok then setLast("ERR notif: " .. tostring(err)) end
        end
        task.wait(CHECK_EVERY)
    end
end)

if AUTO_START then
    task.wait(0.5)
    startRun()
end
